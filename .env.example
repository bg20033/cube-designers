# Optional: defaults to https://www.cube-designers.com. Vercel production builds enable SEO automatically.
PUBLIC_SITE_URL=https://www.cube-designers.com
SEO_DEPLOYMENT=production

# Admin dashboard (/admin). DATABASE_URL is added automatically by the
# Vercel → Neon integration; copy it into .env.local for `npm run dev`.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
ADMIN_PASSWORD=choose-a-long-password
# Optional: signs admin sessions. Changing it logs everyone out.
ADMIN_SESSION_SECRET=random-string-of-32-plus-characters

# Optional package price for invitation orders. Leave unset for a manual quote.
# The admin confirms payment and activates the invitation dashboard.
# INVITATION_PRICE_EUR=49

# Customer photo prints (/shop/foto, wall planner). Added automatically when a
# Blob store is connected to the Vercel project (Storage → Blob); copy it into
# .env.local so `npm run print` can download private originals.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
