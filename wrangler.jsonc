{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  }
}
