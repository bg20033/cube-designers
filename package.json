{
  "name": "cubeweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.prerender.config.ts && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "lint": "oxlint",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:media": "node scripts/verify-portfolio-assets.mjs",
    "media:posters": "node scripts/fetch-museum-posters.mjs",
    "media:archive": "node scripts/fetch-commons-posters.mjs",
    "media:bundles": "node scripts/build-bundle-images.mjs",
    "media:thumbs": "node scripts/build-poster-thumbs.mjs",
    "print": "node scripts/print-files.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "preview:worker": "wrangler dev --config dist/server/wrangler.json --port 4173",
    "test:invitations:online": "npm run build && playwright test --config playwright.invitations.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.26.0",
    "meshline": "^3.3.1",
    "motion": "^12.42.2",
    "postprocessing": "^6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
