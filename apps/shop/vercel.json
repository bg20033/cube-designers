{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://www.cube-designers.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://www.cube-designers.com/admin/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "installCommand": "cd ../.. && npm ci"
}
